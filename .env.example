# Copy to .env.local for development; set the same variables in the hosting
# dashboard for production. Never commit real values.

# ── Supabase (create the project in an EU region) ───────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── E-mail (Resend; the sending domain must be verified: SPF, DKIM, DMARC) ──
RESEND_API_KEY=
# Sender, e.g. "Sain Sanaa <noreply@yourdomain.com>" or plain noreply@yourdomain.com
RESEND_FROM_EMAIL=
# Inbox that receives the new-request alerts (Reply-To is the traveller)
OWNER_EMAIL=

# ── Site ────────────────────────────────────────────────────────────────────
# Public https URL without a trailing slash
NEXT_PUBLIC_APP_URL=https://example.com

# ── Admin panel ─────────────────────────────────────────────────────────────
# Password typed on /admin/login: at least 12 characters
ADMIN_PASSWORD=
# Signs the admin session cookie: at least 32 random characters
#   openssl rand -base64 48
ADMIN_JWT_SECRET=

# ── Optional ────────────────────────────────────────────────────────────────
# Google Search Console panel on the admin dashboard
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SEARCH_CONSOLE_SITE_URL=
# Partner logos fetched from logo.dev
NEXT_PUBLIC_LOGO_DEV_TOKEN=

# Local/demo only: show sample tours while the database is empty. NEVER in production.
# NEXT_PUBLIC_DEMO_MODE=true

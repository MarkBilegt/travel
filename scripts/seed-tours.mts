/**
 * Writes supabase/seed/tours.sql from the cooperative's tours in
 * src/data/demo-tours.ts, so the real database can start with them.
 *   npm run seed:tours
 * The seed never overwrites a tour that already exists (ON CONFLICT DO NOTHING),
 * so edits made later in the admin panel are safe when it is run again.
 */
import { mkdirSync, writeFileSync } from 'node:fs'
import { DEMO_TOURS } from '../src/data/demo-tours.ts'

const q = (v: string) => `'${v.replace(/'/g, "''")}'`
const arr = (list: string[]) => (list.length ? `ARRAY[${list.map(q).join(', ')}]::text[]` : `'{}'::text[]`)
const ints = (list: number[]) => (list.length ? `ARRAY[${list.join(', ')}]::int[]` : `'{}'::int[]`)
const json = (v: unknown) => `${q(JSON.stringify(v))}::jsonb`

const rows = DEMO_TOURS.map((t) => {
  const translations = Object.fromEntries(Object.entries(t.translations ?? {}).map(([lang, v]) => [lang, v]))
  const cols: Record<string, string> = {
    slug: q(t.slug),
    title: q(t.title),
    translations: json(translations),
    description: q(t.description),
    short_description: q(t.shortDescription),
    duration: String(t.duration),
    group_size_min: String(t.groupSize.min),
    group_size_max: String(t.groupSize.max),
    price: String(t.price),
    currency: q(t.currency),
    difficulty: q(t.difficulty),
    category: q(t.category),
    destinations: arr(t.destinations),
    regions: arr(t.regions),
    tour_type: q(t.tourType),
    season_months: ints(t.seasonMonths),
    activities: arr(t.activities),
    accommodation: arr(t.accommodation),
    vehicle: t.vehicle ? q(t.vehicle) : 'NULL',
    price_mode: q(t.priceMode),
    price_tiers: json(t.priceTiers),
    single_supplement: t.singleSupplement ? String(t.singleSupplement) : 'NULL',
    is_new: String(Boolean(t.isNew)),
    includes: arr(t.includes),
    excludes: arr(t.excludes),
    itinerary: json(t.itinerary),
    images: arr(t.images),
    cover_image: q(t.coverImage),
    featured: String(Boolean(t.featured)),
    is_hero: String(Boolean(t.isHero)),
    status: q('active'),
  }
  return `INSERT INTO tours (${Object.keys(cols).join(', ')})\nVALUES (${Object.values(cols).join(', ')})\nON CONFLICT (slug) DO NOTHING;\n`
})

const sql = `-- Generated by scripts/seed-tours.mts from src/data/demo-tours.ts. Do not edit by hand.
-- Run after migrations 001-018. Existing tours (same slug) are left untouched.
-- Photos are stock placeholders: replace them in the admin panel with real ones.

${rows.join('\n')}`

mkdirSync(new URL('../supabase/seed/', import.meta.url), { recursive: true })
writeFileSync(new URL('../supabase/seed/tours.sql', import.meta.url), sql)
console.log(`Wrote ${rows.length} tours to supabase/seed/tours.sql`)

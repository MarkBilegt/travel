/**
 * Writes src/lib/legacy-redirects.generated.ts: one permanent redirect from
 * every old WordPress address that became an article to its new address.
 *   npm run redirects:old-site
 */
import { readFileSync, writeFileSync } from 'node:fs'
import { planFor, type Crawled } from './convert.mts'

const ROUTE = { news: '/blog', trips: '/blog', culture: '/culture', info: '/info' } as const

const site: Crawled[] = JSON.parse(readFileSync(new URL('./data/site.json', import.meta.url), 'utf8'))
const rows: [string, string][] = []
for (const item of site) {
  const plan = planFor(item)
  if (plan.type === 'article') rows.push([`/${item.path}`, `/it${ROUTE[plan.category]}/${plan.slug}`])
  if (plan.type === 'gallery') rows.push([`/${item.path}`, '/it/gallery'])
}

const body = `/**
 * Generated by scripts/old-site/generate-redirects.mts from the crawl of the old
 * site. Do not edit by hand: run \`npm run redirects:old-site\`.
 * [old path, new path]
 */
export const GENERATED_REDIRECTS: [string, string][] = ${JSON.stringify(rows, null, 2)}
`
writeFileSync(new URL('../../src/lib/legacy-redirects.generated.ts', import.meta.url), body)
console.log(`Wrote ${rows.length} redirects`)

/**
 * Joins every migration (001, 002, ...) into ONE file, supabase/full-setup.sql,
 * for a brand-new, empty Supabase project: paste it in the SQL Editor and run it once.
 *   npm run db:bundle
 * Do NOT run it on a project that already has some migrations applied; run the missing numbered files instead.
 */
import { readdirSync, readFileSync, writeFileSync } from 'node:fs'

const dir = new URL('../supabase/migrations/', import.meta.url)
const files = readdirSync(dir).filter((f) => f.endsWith('.sql')).sort()

const parts = files.map((f) => `-- ════════════════════════════════════════════════════════════════════════════\n-- ${f}\n-- ════════════════════════════════════════════════════════════════════════════\n\n${readFileSync(new URL(f, dir), 'utf8').trim()}\n`)

const header = `-- Sain Sanaa website: complete database setup (${files.length} migrations, ${files[0]} to ${files[files.length - 1]}).
-- Generated by scripts/bundle-sql.mts: do not edit by hand.
--
-- FOR A NEW, EMPTY SUPABASE PROJECT ONLY. Paste into Supabase > SQL Editor > New query and run once.
-- If some migrations were already applied, run only the missing numbered files in supabase/migrations instead.
-- Afterwards (optional sample content): supabase/seed/tours.sql and supabase/seed/testimonials.sql,
-- then "npm run import:old-site" for the articles and photos.

`
writeFileSync(new URL('../supabase/full-setup.sql', import.meta.url), header + parts.join('\n'))
console.log(`Wrote supabase/full-setup.sql from ${files.length} migrations`)
